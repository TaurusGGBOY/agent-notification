{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentNotify",
  "version": "1.0.1",
  "identifier": "com.agentnotify.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentNotify",
        "width": 1200,
        "height": 675,
        "resizable": false,
        "fullscreen": false,
        "theme": "Light",
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agent-notify-server"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
