{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentNotify",
  "version": "1.0.8",
  "identifier": "com.agentnotify.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentNotify",
        "width": 1200,
        "height": 675,
        "resizable": false,
        "fullscreen": false,
        "theme": "Light",
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/agent-notify-server"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0NTNGNEVCRjQ1NzhBNjUKUldSbGlsZjA2L1JURklSUEJOM2NueVJxMk5YTkRwMEZ1VW1YVm9kNGdtZHM3UXFXQW9aSHdjakkK",
      "endpoints": [
        "https://github.com/TaurusGGBOY/agent-notification/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
