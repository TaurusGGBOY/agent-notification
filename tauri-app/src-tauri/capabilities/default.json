{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/agent-notify-server",
          "sidecar": true
        }
      ]
    },
    "notification:default"
  ]
}
